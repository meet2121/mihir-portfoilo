---
import Icon from '../ui/Icon.astro';
import { profile } from '../../data/profile';

const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__intro">
        <p class="eyebrow"><span class="status-dot" data-status="live"></span> Contact</p>
        <h2 id="contact-heading">Let’s talk about AI systems that have to be right.</h2>
        <p class="muted">
          Open to conversations about GenAI, document intelligence, data science and automation roles.
        </p>
      </div>

      <ul class="contact-list" role="list">
        <li>
          <a class="contact-item" href={`mailto:${profile.email}`}>
            <Icon name="mail" />
            <span>
              <span class="contact-item__label">Email</span>
              <span class="contact-item__value">{profile.email}</span>
            </span>
          </a>
        </li>
        <li>
          <a class="contact-item" href={profile.phoneHref}>
            <Icon name="phone" />
            <span>
              <span class="contact-item__label">Phone</span>
              <span class="contact-item__value mono">{profile.phone}</span>
            </span>
          </a>
        </li>
        <li>
          <a class="contact-item" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
            <Icon name="linkedin" />
            <span>
              <span class="contact-item__label">LinkedIn</span>
              <span class="contact-item__value">mihir-brahmaniya <span class="visually-hidden">(opens in a new tab)</span></span>
            </span>
            <Icon name="arrow-up-right" class="contact-item__ext" size={16} />
          </a>
        </li>
        <li>
          <div class="contact-item contact-item--static">
            <Icon name="map-pin" />
            <span>
              <span class="contact-item__label">Location</span>
              <span class="contact-item__value">{profile.location}</span>
            </span>
          </div>
        </li>
      </ul>
    </div>

    <div class="site-footer__base">
      <p>© {year} {profile.name}</p>
      <p class="site-footer__note">
        <Icon name="lock" size={14} />
        Project demos use synthetic data. No company systems, data or code are exposed.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    background: linear-gradient(180deg, var(--bg-elevated), var(--bg));
    padding-top: var(--space-20);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-12);
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .site-footer__grid {
      grid-template-columns: 1.1fr 1fr;
      align-items: start;
    }
  }

  .site-footer__intro {
    display: grid;
    gap: var(--space-4);
    max-width: 520px;
  }

  .site-footer__intro h2 {
    font-size: var(--text-2xl);
    line-height: 1.15;
  }

  .contact-list {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    color: var(--text-muted);
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  a.contact-item:hover {
    border-color: var(--border);
    background: var(--surface-2);
  }

  .contact-item :global(svg) {
    flex: none;
    color: var(--accent);
  }

  .contact-item > span {
    display: grid;
    min-width: 0;
  }

  .contact-item__label {
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }

  .contact-item__value {
    color: var(--text);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .contact-item :global(.contact-item__ext) {
    margin-left: auto;
    color: var(--text-subtle);
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-16);
    padding-block: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    color: var(--text-subtle);
    font-size: var(--text-sm);
  }

  .site-footer__note {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
</style>
